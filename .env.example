# =====================================================================
# Variables d'environnement — site Formation Compétences
# =====================================================================
# En local : copier ce fichier en .env (gitignored), le serveur Express le lit (dotenv).
# En production : Netlify > Project configuration > Environment variables
#   (bouton « Import from a .env file » pour coller plusieurs variables d'un coup).
# Après toute modification sur Netlify : Deploys > Trigger deploy > Deploy project.

# ---------------------------------------------------------------------
# 1. CRM Zoho — capture des leads (/api/leads). Voir docs/ZOHO-SETUP.md
# ---------------------------------------------------------------------
# dry_run : aucun appel à Zoho (DÉFAUT) · shadow : contact créé sans workflow · live : production
ZOHO_MODE=dry_run
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Europe : https://accounts.zoho.eu / https://www.zohoapis.eu — USA : .com / zohoapis.com
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.eu
ZOHO_API_DOMAIN=https://www.zohoapis.eu
# Requêtes max par IP et par minute sur /api/leads
LEAD_RATE_LIMIT_PER_MIN=5

# ---------------------------------------------------------------------
# 2. Suivi des visites de la landing Lilmod. Voir docs/SUIVI-VISITES-LILMOD.md
# ---------------------------------------------------------------------
# E-mails récapitulatifs via Brevo (brevo.com > SMTP & API > API keys)
BREVO_API_KEY=
# Expéditeur vérifié dans Brevo (Senders)
NOTIFY_FROM=
NOTIFY_FROM_NAME=Suivi landing Lilmod
# Destinataires, séparés par des virgules
NOTIFY_EMAILS=
# Mot de passe (16 caractères min.) de la page /api/visits ; vide = page désactivée
VISITS_ADMIN_TOKEN=
# Alerte GitHub si Brevo échoue : jeton fine-grained, dépôt site-formation-competences-v2,
# permission Issues : Read and write ; vide = pas d'alerte GitHub
GITHUB_ALERT_TOKEN=
# Dépôt des alertes (défaut : YoavPython/site-formation-competences-v2)
GITHUB_ALERT_REPO=

# ---------------------------------------------------------------------
# 3. Local uniquement
# ---------------------------------------------------------------------
PORT=8080
